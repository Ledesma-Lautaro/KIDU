
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Zapatilla {
  id          String   @id @default(uuid())
  marca       String
  modelo      String
  categoria   String
  precio      Int
  descripcion String?
  imagenes    String[] @default([])
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  talles Talle[]

  @@index([activo])
  @@index([marca])
  @@index([categoria])
  @@index([precio])
}

model Talle {
  id          String @id @default(uuid())
  talle       Float
  stock       Boolean @default(true)
  zapatillaId String

  zapatilla Zapatilla @relation(fields: [zapatillaId], references: [id], onDelete: Cascade)

  @@unique([zapatillaId, talle])
  @@index([talle])
}
