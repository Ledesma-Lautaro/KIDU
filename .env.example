# ─────────────────────────────────────────────────────────────
# Base de datos (Vercel Postgres / Neon)
# En Neon: Dashboard → Connection string. Usá la "pooled" para DATABASE_URL
# y la "direct" (sin -pooler) para DIRECT_URL, que Prisma usa en migraciones.
# ─────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://usuario:password@host/db?sslmode=require"
DIRECT_URL="postgresql://usuario:password@host/db?sslmode=require"

# ─────────────────────────────────────────────────────────────
# Login del panel /admin (no hay registro público)
# Generá el secret con: npx auth secret   (o: openssl rand -base64 32)
# ─────────────────────────────────────────────────────────────
AUTH_SECRET="reemplazar-por-un-secret-largo-y-aleatorio"
ADMIN_USER="admin"
ADMIN_PASSWORD="cambiar-esta-password"

# ─────────────────────────────────────────────────────────────
# Vercel Blob (subida de imágenes desde el admin)
# Vercel → Storage → Blob → .env.local tab
# ─────────────────────────────────────────────────────────────
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxx"

# ─────────────────────────────────────────────────────────────
# Contacto
# Número de WhatsApp en formato internacional SIN + ni espacios.
# Ej. Argentina: 5491122334455
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_WHATSAPP_NUMBER="5491100000000"

# URL pública del sitio, para armar el link que se manda por WhatsApp.
# En local: http://localhost:3000 — en Vercel: https://tu-proyecto.vercel.app
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
